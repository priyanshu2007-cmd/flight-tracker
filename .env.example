# Copy to .env (git-ignored). Placeholders only - never commit real values.
SERPAPI_API_KEY=your-serpapi-key
ALERT_TO=spec.priyanshu@gmail.com
GMAIL_CLIENT_FILE=secrets/gmail_client.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json
TRACKER_DB=data/tracker.db
# 1 = every genuine drop of at least 1 INR below the last alerted price
MIN_DROP_INR=1
# API searches per target per run used to verify seller price + baggage
MAX_BOOKING_LOOKUPS=3
# Gmail app password (spaces optional). When set, it is used instead of the OAuth token.
GMAIL_APP_PASSWORD=your-16-char-app-password
DRY_RUN=0
